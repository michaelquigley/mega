#!/usr/bin/env node
// a stand-in for `codex app-server`, for browser checks that need no model
// turns. point a scratch service's codex.binary at this file. it speaks the
// subset of the app-server's stdio JSON-RPC the codex adapter uses, with the
// frames codex-cli 0.166.0 sends (capability report, 2026-11-09), and never
// runs codex. a turn's text drives it:
//   mcp TEXT     an MCP tool approval for fixture/echo with TEXT; accepted, the
//                tool "runs" and the reply is "echo: TEXT"; declined, the call
//                fails as codex reports it
//   form         a typed form elicitation (a color enum and a note); the reply
//                is the content it was answered with
//   background MS  a command left running as a terminal session: its
//                item/started, the reply, the turn's end, then its
//                item/completed MS later, outside the turn (codex-cli 0.166.0)
//   mcp-sign-in  a reply of "signed in"; the docs MCP server is connected
//                from then on, announced with mcpServer/startupStatus/updated
//   anything     a reply of "ok"
// turn/interrupt resolves a pending elicitation and ends the turn interrupted.
// thread/resume with no turn/start holds the thread idle until a prompt, as
// codex does, so a start with no prompt needs nothing more.
//
// models: model/list offers fake-large (low to high, the default) and
// fake-small (low and medium); config/read says the checkout inherits
// fake-large at medium. a thread runs what thread/start or thread/resume
// passed, or the inherited model; a turn/start model or effort override is
// kept for later turns and reported with thread/settings/updated before the
// turn, as codex-cli 0.166.0 does.
//
// MCP servers: thread/start and thread/resume announce each server's
// startup with mcpServer/startupStatus/updated, and mcpServerStatus/list,
// asked with the thread's id, gives three, shaped as codex-cli 0.166.0
// shapes them (capability report, 2026-11-12): fixture, connected, with two
// tools and their descriptions; docs, which needs signing in until an
// mcp-sign-in turn; and broken, which failed to start.
import { randomUUID } from 'node:crypto'
import { createInterface } from 'node:readline'

if (process.argv[2] !== 'app-server') {
  process.stderr.write('fake codex: only app-server is supported\n')
  process.exit(2)
}

const send = (msg) => process.stdout.write(JSON.stringify({ jsonrpc: '2.0', ...msg }) + '\n')
const notify = (method, params) => send({ method, params })
const id = () => randomUUID()
let threadID = null
let activeTurn = null
let nextRequest = 0
const pending = new Map() // our server request id -> {resolve, turn}

const catalog = [
  { id: 'fake-large', model: 'fake-large', displayName: 'Fake Large', description: 'The bigger stand-in.', hidden: false, isDefault: true, defaultReasoningEffort: 'medium', supportedReasoningEfforts: ['low', 'medium', 'high'].map((reasoningEffort) => ({ reasoningEffort, description: reasoningEffort })) },
  { id: 'fake-small', model: 'fake-small', displayName: 'Fake Small', description: 'The smaller stand-in.', hidden: false, isDefault: false, defaultReasoningEffort: 'low', supportedReasoningEfforts: ['low', 'medium'].map((reasoningEffort) => ({ reasoningEffort, description: reasoningEffort })) },
  { id: 'fake-hidden', model: 'fake-hidden', displayName: 'Fake Hidden', description: 'Never offered.', hidden: true, isDefault: false, defaultReasoningEffort: 'low', supportedReasoningEfforts: [] },
]
const inherited = { model: 'fake-large', model_reasoning_effort: 'medium' }
let runModel = inherited.model
let runEffort = inherited.model_reasoning_effort

let docsSignedIn = false
const mcpServers = () => [
  {
    name: 'broken',
    authStatus: 'unsupported',
    runtimeStatus: 'failed',
    tools: {},
    toolsError: 'MCP startup failed: No such file or directory (os error 2)',
    resources: [],
    resourceTemplates: [],
  },
  docsSignedIn
    ? { name: 'docs', authStatus: 'oAuth', runtimeStatus: 'connected', tools: { search: { name: 'search', title: 'Search', description: 'Search the documentation.\nReturns the best matches.' } }, toolsError: null, resources: [], resourceTemplates: [] }
    : { name: 'docs', authStatus: 'notLoggedIn', runtimeStatus: 'authenticationRequired', tools: {}, toolsError: null, resources: [], resourceTemplates: [] },
  {
    name: 'fixture',
    authStatus: 'unsupported',
    runtimeStatus: 'connected',
    serverInfo: { name: 'fixture', version: '0.0.1' },
    tools: {
      pick_color: { name: 'pick_color', description: 'Ask the user to pick a color through an elicitation form.' },
      echo: { name: 'echo', description: 'Echo the given text back, and log the call.' },
    },
    toolsError: null,
    resources: [],
    resourceTemplates: [],
  },
]
const startup = (name, status, error = null, failureReason = null) =>
  notify('mcpServer/startupStatus/updated', { name, status, error, failureReason, threadId: threadID })
// announceStartup sends what codex sends as a thread's servers start: each
// starting, then ready or failed.
const announceStartup = () => {
  for (const s of mcpServers()) startup(s.name, 'starting')
  startup('fixture', 'ready')
  startup('broken', 'failed', 'MCP client for `broken` failed to start: MCP startup failed: No such file or directory (os error 2)')
  if (docsSignedIn) startup('docs', 'ready')
  else startup('docs', 'failed', 'MCP client for `docs` needs signing in', 'reauthenticationRequired')
}

const thread = (tid) => ({ id: tid, cliVersion: 'fake', cwd: process.cwd(), preview: '', createdAt: 0, updatedAt: 0, turns: [] })
const started = (tid) => ({ thread: thread(tid), model: runModel, reasoningEffort: runEffort, cwd: process.cwd(), approvalPolicy: 'on-request', sandbox: { type: 'workspaceWrite' }, instructionSources: [] })

const ask = (method, params) =>
  new Promise((resolve) => {
    const rid = nextRequest++
    pending.set(rid, { resolve, turn: activeTurn })
    send({ id: rid, method, params })
  })

const agent = (turn, text) =>
  notify('item/completed', { threadId: threadID, turnId: turn, item: { type: 'agentMessage', id: `msg-${id()}`, text } })
const finish = (turn, status = 'completed') => {
  if (activeTurn !== turn) return
  activeTurn = null
  notify('turn/completed', { threadId: threadID, turn: { id: turn, status, items: [], error: null } })
}

async function runTurn(turn, text) {
  const [verb, ...rest] = text.trim().split(/\s+/)
  if (verb === 'mcp') {
    const arg = rest.join(' ') || 'hello'
    const item = `exec-${id()}`
    notify('item/started', { threadId: threadID, turnId: turn, item: { type: 'mcpToolCall', id: item, server: 'fixture', tool: 'echo', status: 'inProgress', arguments: { text: arg } } })
    const answer = await ask('mcpServer/elicitation/request', {
      threadId: threadID,
      turnId: turn,
      serverName: 'fixture',
      mode: 'form',
      _meta: {
        codex_approval_kind: 'mcp_tool_call',
        persist: ['session', 'always'],
        tool_description: 'Echo the given text back, and log the call.',
        tool_params: { text: arg },
        tool_params_display: [{ name: 'text', value: arg, display_name: 'text' }],
      },
      message: 'Allow the fixture MCP server to run tool "echo"?',
      requestedSchema: { type: 'object', properties: {} },
    })
    if (answer === null) return // resolved by an interrupt
    const accepted = answer.action === 'accept'
    notify('item/completed', {
      threadId: threadID,
      turnId: turn,
      item: { type: 'mcpToolCall', id: item, server: 'fixture', tool: 'echo', status: accepted ? 'completed' : 'failed', arguments: { text: arg }, result: accepted ? { content: [{ type: 'text', text: `echo: ${arg}` }] } : null, error: accepted ? null : { message: 'user rejected MCP tool call' } },
    })
    agent(turn, accepted ? `echo: ${arg}` + (answer._meta?.persist ? ` (approved for the ${answer._meta.persist})` : '') : 'DECLINED')
  } else if (verb === 'mcp-sign-in') {
    docsSignedIn = true
    startup('docs', 'ready')
    agent(turn, 'signed in')
  } else if (verb === 'form') {
    const answer = await ask('mcpServer/elicitation/request', {
      threadId: threadID,
      turnId: turn,
      serverName: 'fixture',
      mode: 'form',
      _meta: null,
      message: 'Which color do you prefer?',
      requestedSchema: {
        type: 'object',
        properties: { color: { type: 'string', title: 'Color', enum: ['Red', 'Blue'] }, note: { type: 'string', title: 'Note', description: 'Anything to add' } },
        required: ['color'],
      },
    })
    if (answer === null) return
    agent(turn, `elicitation answered: ${JSON.stringify(answer)}`)
  } else if (verb === 'background') {
    const item = { type: 'commandExecution', id: `exec-${id()}`, command: "/bin/bash -lc 'sleep 30 && echo BG-FAKE-DONE'", cwd: process.cwd(), processId: '4242', status: 'inProgress' }
    notify('item/started', { threadId: threadID, turnId: turn, item })
    agent(turn, 'BG-STARTED')
    finish(turn)
    setTimeout(() => notify('item/completed', { threadId: threadID, turnId: turn, item: { ...item, status: 'completed', exitCode: 0, aggregatedOutput: 'BG-FAKE-DONE\n' } }), Number(rest[0]) || 5000)
    return
  } else {
    agent(turn, 'ok')
  }
  finish(turn)
}

createInterface({ input: process.stdin }).on('line', (line) => {
  if (!line.trim()) return
  const msg = JSON.parse(line)
  if (msg.method === undefined) {
    const waiting = pending.get(msg.id)
    if (waiting) {
      pending.delete(msg.id)
      waiting.resolve(msg.result ?? null)
    }
    return
  }
  const p = msg.params ?? {}
  switch (msg.method) {
    case 'initialize':
      send({ id: msg.id, result: { userAgent: 'fake-codex/0.0.0-fake', codexHome: '/nowhere', platformFamily: 'unix', platformOs: 'linux' } })
      break
    case 'initialized':
      break
    case 'model/list':
      send({ id: msg.id, result: { data: catalog, nextCursor: null } })
      break
    case 'config/read':
      send({ id: msg.id, result: { config: { ...inherited }, origins: {} } })
      break
    case 'thread/start':
      runModel = p.model ?? inherited.model
      runEffort = inherited.model_reasoning_effort
      threadID = id()
      send({ id: msg.id, result: started(threadID) })
      announceStartup()
      break
    case 'thread/resume':
      if (p.model) runModel = p.model
      threadID = p.threadId
      send({ id: msg.id, result: started(threadID) })
      announceStartup()
      break
    case 'mcpServerStatus/list':
      if (p.threadId !== threadID) {
        send({ id: msg.id, error: { code: -32602, message: `fake codex: no thread '${p.threadId}'` } })
        break
      }
      send({ id: msg.id, result: { data: mcpServers(), nextCursor: null } })
      break
    case 'thread/read':
      send({ id: msg.id, result: { thread: thread(p.threadId) } })
      break
    case 'thread/list':
      send({ id: msg.id, result: { data: [] } })
      break
    case 'turn/start': {
      const turn = id()
      activeTurn = turn
      const text = (p.input ?? []).map((i) => i.text ?? '').join('')
      if ((p.model && p.model !== runModel) || (p.effort && p.effort !== runEffort)) {
        runModel = p.model ?? runModel
        runEffort = p.effort ?? runEffort
        notify('thread/settings/updated', { threadId: threadID, threadSettings: { model: runModel, effort: runEffort } })
      }
      send({ id: msg.id, result: { turn: { id: turn, status: 'inProgress', items: [] } } })
      notify('turn/started', { threadId: threadID, turn: { id: turn, status: 'inProgress', items: [] } })
      notify('item/completed', { threadId: threadID, turnId: turn, item: { type: 'userMessage', id: id(), clientId: p.clientUserMessageId, content: [{ type: 'text', text }] } })
      void runTurn(turn, text)
      break
    }
    case 'turn/interrupt': {
      send({ id: msg.id, result: {} })
      // as codex-cli 0.166.0 does: the turn ends interrupted, then each of its
      // pending elicitations is resolved.
      const turn = p.turnId
      const resolved = []
      for (const [rid, waiting] of pending) {
        if (waiting.turn === turn) {
          pending.delete(rid)
          waiting.resolve(null)
          resolved.push(rid)
        }
      }
      finish(turn, 'interrupted')
      for (const rid of resolved) notify('serverRequest/resolved', { threadId: threadID, requestId: rid })
      break
    }
    default:
      send({ id: msg.id, error: { code: -32601, message: `fake codex: ${msg.method} is not supported` } })
  }
})
